{
  "name": "clean-code-todo",
  "version": "1.0.0",
  "description": "A study repository for the Clean Code assignment in the RS School Fullstack Engineering course",
  "keywords": [
    "clean-code",
    "refactoring",
    "code-quality",
    "eslint",
    "prettier",
    "husky",
    "javascript",
    "git"
  ],
  "homepage": "https://github.com/sofiiadorosh/clean-code-todo#readme",
  "bugs": {
    "url": "https://github.com/sofiiadorosh/clean-code-todo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sofiiadorosh/clean-code-todo.git"
  },
  "author": "Sofiia Dorosh",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,html,css}": [
      "prettier --check"
    ],
    "*.js": [
      "eslint"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
